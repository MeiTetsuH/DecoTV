# DecoTV Environment Variables Example (Vercel)
# Configure these values in Vercel Dashboard -> Settings -> Environment Variables.

# ===== Required =====

# Storage: 'upstash' (recommended on Vercel) | 'localstorage'
NEXT_PUBLIC_STORAGE_TYPE=upstash

# Owner credentials used by the current authentication implementation
USERNAME=admin
PASSWORD=replace_with_a_strong_password

# Required in production for cookie/signature security
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required by /api/cron. Vercel sends it as Authorization: Bearer <CRON_SECRET>.
# Use a different random value from AUTH_SECRET.
CRON_SECRET=

NEXT_PUBLIC_SITE_NAME=DecoTV

# ===== Upstash Redis =====

# Vercel Marketplace integrations commonly inject this pair automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The application also accepts either pair below.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_URL=
# UPSTASH_TOKEN=

# ===== Authentication and registration =====

# 'password' (default) | 'public' (trusted networks only)
NEXT_PUBLIC_AUTH_MODE=password
# Exposing the admin panel in public mode is high risk and disabled by default.
PUBLIC_ALLOW_ADMIN=false

# Legacy migration defaults. Runtime registration settings live in /admin.
NEXT_PUBLIC_ENABLE_REGISTRATION=false
# DEFAULT_REGISTRATION_GROUP=

# ===== Search and site behavior =====

# 'infinite' | 'pagination'
NEXT_PUBLIC_SEARCH_RESULT_LOAD_MODE=infinite
NEXT_PUBLIC_FLUID_SEARCH=true
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false

# ===== Douban and TMDB =====

# Douban proxy: auto | direct | server | cors-proxy-zwei | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=auto
NEXT_PUBLIC_DOUBAN_PROXY=
# Douban image proxy: auto | direct | server | img3 | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=auto
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=
DOUBAN_API_KEY=

TMDB_API_KEY=
TMDB_PROXY=
TMDB_REVERSE_PROXY=

# ===== Private library (also configurable in /admin) =====

OPENLIST_URL=
OPENLIST_TOKEN=
OPENLIST_ROOT_PATH=/Media
EMBY_URL=
EMBY_API_KEY=
EMBY_USER_ID=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# ===== PanSou =====

PANSOU_PROXY_TIMEOUT_MS=15000

# ===== Vercel runtime notes =====

# Server-side FFmpeg jobs are intentionally disabled on Vercel by default.
# Browser downloads and streaming proxy routes remain available.
# FFMPEG_ALLOW_SERVERLESS=false

# ===== M3U8 ad filtering =====

ENABLE_AD_FILTER=true
# Optional signing secret; falls back to AUTH_SECRET/PASSWORD when omitted.
# M3U8_PROXY_SIGNING_SECRET=
# AD_FILTER_MIN_DURATION=3
# AD_FILTER_MAX_DURATION=120
# AD_FILTER_MAX_SEGMENTS=15

# ===== Dandanplay =====

# Keep these server-only. Never add a NEXT_PUBLIC_ prefix.
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=
# DANDANPLAY_RELAY_URL=https://your-decotv-relay.example.com
# DANDANPLAY_PUBLIC_RELAY_ENABLED=true
