{
  "name": "decotv",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "pnpm gen:manifest && pnpm gen:version && next dev -H 0.0.0.0",
    "build": "pnpm gen:manifest && pnpm gen:version && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:version": "node scripts/generate-version-metadata.js",
    "copy:version": "pnpm gen:version",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@types/crypto-js": "^4.2.2",
    "@upstash/redis": "^1.39.0",
    "@vidstack/react": "^1.15.7",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "bs58": "^6.0.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "flv.js": "^1.6.2",
    "framer-motion": "^12.43.0",
    "he": "^1.2.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.438.0",
    "media-icons": "^1.1.5",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nprogress": "^0.2.0",
    "opencc-js": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.19",
    "tailwind-merge": "^2.6.1",
    "vidstack": "^0.6.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.3",
    "@types/bs58": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.13",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "webpack-obfuscator": "^3.6.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "pnpm": {
    "overrides": {
      "@commitlint/is-ignored>semver": "^7.5.2",
      "eslint-plugin-react-hooks@7.1.1>zod": "4.6.7"
    }
  }
}
